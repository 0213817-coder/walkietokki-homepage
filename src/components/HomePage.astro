---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from './Section.astro';
import { t, type Lang } from '../i18n/strings';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);

// 추가 기능용 모노톤 SVG (Tabler 스타일)
const moreIcons = [
  // ride history (clock)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  // bell
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5a2 2 0 0 1 4 0"/><path d="M5 17V11a7 7 0 1 1 14 0v6"/><path d="M4 17h16"/><path d="M9 21a3 3 0 0 0 6 0"/></svg>',
  // users
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 2.7-5 6-5s6 2 6 5"/><circle cx="17" cy="8" r="2.5"/><path d="M15 13.5c2.6.3 4.5 2 4.5 4.5"/></svg>',
  // shield
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>',
  // sparkle (Pro)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/></svg>',
  // user-circle (nickname)
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/><path d="M6.5 19a6.5 6.5 0 0 1 11 0"/></svg>',
];

// Platform diff 아이콘 (iOS = apple, Android = robot 느낌)
const iosIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 12.5c0-2.4 2-3.5 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.5 0 1.9.8 3.3.8 1.4 0 2.3-1.3 3.1-2.5.6-.9 1.1-2 1.4-3.1-3.5-1.3-3-5.1-3-5.2zM15.4 5.3c.7-.9 1.2-2.1 1-3.3-1.1.1-2.3.7-3 1.6-.6.8-1.2 2-1 3.2 1.2.1 2.4-.6 3-1.5z"/></svg>';
const androidIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 9.5h-1V8a3 3 0 0 0-1.5-2.6l.9-1.6a.3.3 0 0 0-.5-.3l-.9 1.6a3 3 0 0 0-2 0L10 3.5a.3.3 0 1 0-.5.3L10.4 5.4A3 3 0 0 0 8.9 8v1.5H8c-.8 0-1.5.7-1.5 1.5v6c0 .8.7 1.5 1.5 1.5h.5v2c0 .6.4 1 1 1s1-.4 1-1v-2h3v2c0 .6.4 1 1 1s1-.4 1-1v-2h.5c.8 0 1.5-.7 1.5-1.5v-6c0-.8-.7-1.5-1.5-1.5zM10 7.3c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6zm4 0c.3 0 .6.3.6.6s-.3.6-.6.6-.6-.3-.6-.6.3-.6.6-.6zM5 10.5c-.6 0-1 .4-1 1v4c0 .6.4 1 1 1s1-.4 1-1v-4c0-.6-.4-1-1-1zm14 0c-.6 0-1 .4-1 1v4c0 .6.4 1 1 1s1-.4 1-1v-4c0-.6-.4-1-1-1z"/></svg>';
---

<BaseLayout lang={lang}>
  {/* ───── Section 2. Hero ───── */}
  <Section className="text-center">
    <span class="inline-block px-3 py-1.5 rounded-full bg-accent-soft text-accent text-[12px] font-medium tracking-tight mb-7">
      {s.hero.badge}
    </span>
    <h1 class="text-[36px] md:text-h1-d font-bold tracking-tighter mb-5 leading-tight">
      {s.hero.title1}<br />
      {s.hero.title2}
    </h1>
    <p class="text-[16px] md:text-[18px] text-text-secondary leading-body max-w-xl mx-auto mb-10">
      {s.hero.sub1}<br class="hidden sm:block" />
      {s.hero.sub2}
    </p>
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <a
        href={s.hero.ctaPrimaryHref}
        class="inline-flex items-center justify-center h-12 px-7 rounded-btn bg-accent hover:bg-accent/90 text-white font-semibold transition"
      >
        {s.hero.ctaPrimary}
      </a>
      <a
        href="#features"
        class="inline-flex items-center justify-center h-12 px-7 rounded-btn bg-bg-secondary hover:bg-bg-tertiary border border-border text-text-primary font-semibold transition"
      >
        {s.hero.ctaSecondary}
      </a>
    </div>
    <div class="flex justify-center">
      <img
        src="/assets/walkietokki-hero.png"
        alt=""
        width="240"
        height="240"
        class="w-[200px] md:w-[240px] h-auto"
        loading="eager"
        decoding="async"
      />
    </div>
  </Section>

  {/* ───── Section 3. Core features (4개) ───── */}
  <Section id="features">
    <h2 class="text-[26px] md:text-h2-d font-bold tracking-tighter mb-10 text-center">
      {s.coreFeatures.heading}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {s.coreFeatures.items.map((it) => (
        <div class="bg-bg-secondary border border-border rounded-card p-6 hover:bg-bg-tertiary transition">
          <img
            src={`/assets/${it.icon}`}
            alt=""
            width="64"
            height="64"
            class="w-[64px] h-[64px] mb-5"
            loading="lazy"
            decoding="async"
          />
          <h3 class="text-[17px] font-semibold tracking-tight mb-2 leading-snug">{it.title}</h3>
          <p class="text-text-secondary leading-body text-[14px]">{it.body}</p>
        </div>
      ))}
    </div>

    {/* Platform diff (iOS vs Android) */}
    <div class="mt-14 max-w-4xl mx-auto">
      <h3 class="text-[18px] md:text-[20px] font-semibold text-center mb-6 text-text-primary">
        {s.coreFeatures.platformDiff.heading}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-bg-secondary border border-border rounded-card p-6 flex gap-4">
          <span class="shrink-0 w-10 h-10 rounded-lg bg-bg-tertiary text-text-primary flex items-center justify-center" set:html={iosIcon} />
          <div>
            <div class="text-[15px] font-semibold mb-2">{s.coreFeatures.platformDiff.ios.label}</div>
            <p class="text-text-secondary text-[13.5px] leading-body">{s.coreFeatures.platformDiff.ios.body}</p>
          </div>
        </div>
        <div class="bg-bg-secondary border border-border rounded-card p-6 flex gap-4">
          <span class="shrink-0 w-10 h-10 rounded-lg bg-bg-tertiary text-text-primary flex items-center justify-center" set:html={androidIcon} />
          <div>
            <div class="text-[15px] font-semibold mb-2">{s.coreFeatures.platformDiff.android.label}</div>
            <p class="text-text-secondary text-[13.5px] leading-body">{s.coreFeatures.platformDiff.android.body}</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {/* ───── Section 4. More features (2x3) ───── */}
  <Section size="md">
    <h2 class="text-[22px] md:text-h3-d font-bold tracking-tighter mb-7 text-center">
      {s.moreFeatures.heading}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {s.moreFeatures.items.map((it, i) => (
        <div class="bg-bg-secondary border border-border rounded-card p-5 flex gap-4 items-start">
          <span class="shrink-0 w-10 h-10 rounded-lg bg-accent-soft text-accent flex items-center justify-center" set:html={moreIcons[i % moreIcons.length]} />
          <div>
            <h3 class="text-[15px] font-semibold mb-1.5">{it.title}</h3>
            <p class="text-text-secondary text-[13.5px] leading-body">{it.body}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  {/* ───── Section 5. How it works ───── */}
  <Section id="how">
    <h2 class="text-[26px] md:text-h2-d font-bold tracking-tighter mb-10 text-center">
      {s.howItWorks.heading}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {s.howItWorks.steps.map((st) => (
        <div class="bg-bg-secondary border border-border rounded-card p-7">
          <div class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-bold text-[15px] mb-5">
            {st.num}
          </div>
          <h3 class="text-[17px] font-semibold mb-2">{st.title}</h3>
          <p class="text-text-secondary leading-body text-[14.5px]">{st.body}</p>
        </div>
      ))}
    </div>
  </Section>

  {/* ───── Section 6. FAQ ───── */}
  <Section id="faq" size="md">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-[26px] md:text-h2-d font-bold tracking-tighter mb-3 text-center">
        {s.faq.heading}
      </h2>
      <p class="text-text-secondary text-center mb-10">{s.faq.sub}</p>
      <div class="space-y-3">
        {s.faq.items.map((item, idx) => (
          <details
            class="group bg-bg-secondary border border-border rounded-card overflow-hidden hover:bg-bg-tertiary transition"
            open={idx === 0}
          >
            <summary class="cursor-pointer list-none flex items-center justify-between px-6 py-5 text-[15px] md:text-[16px] font-semibold">
              <span class="pr-4">{item.q}</span>
              <span class="shrink-0 text-accent text-[24px] leading-none transition-transform group-open:rotate-45 select-none">+</span>
            </summary>
            <div class="px-6 pb-6 text-text-secondary text-[14px] md:text-[14.5px] leading-body">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </Section>

  {/* ───── Section 7. Beta banner ───── */}
  <Section>
    <div class="bg-accent-soft border border-accent/30 rounded-[20px] p-10 md:p-14 text-center">
      <h2 class="text-[24px] md:text-h2-d font-bold tracking-tighter mb-3">
        {s.betaBanner.heading}
      </h2>
      <p class="text-text-secondary text-[15px] md:text-[17px] mb-7">
        {s.betaBanner.body}
      </p>
      <a
        href={s.betaBanner.ctaHref}
        class="inline-flex items-center justify-center h-12 px-7 rounded-btn bg-accent hover:bg-accent/90 text-white font-semibold transition"
      >
        {s.betaBanner.cta}
      </a>
    </div>
  </Section>

  {/* ───── Section 8. Reviews (placeholder) ───── */}
  <Section id="reviews" size="md">
    <div class="text-center">
      <h2 class="text-[22px] md:text-h3-d font-bold tracking-tighter mb-3">
        {s.reviews.heading}
      </h2>
      <p class="text-text-tertiary">{s.reviews.placeholder}</p>
    </div>
  </Section>
</BaseLayout>
