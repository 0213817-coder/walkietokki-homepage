---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
---
<BaseLayout lang="en" title="Reviews" description="What beta riders are saying">
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-[32px] md:text-[40px] font-bold tracking-tighter mb-4">From our beta riders</h1>
      <p class="text-text-secondary leading-body mb-12">
        Real rider stories are coming around launch.<br />
        For now, the fastest way to know is to try it yourself.
      </p>

      <div class="bg-bg-secondary border border-border rounded-card p-10 text-text-tertiary">
        Coming soon.
      </div>

      <a
        href="/en/beta"
        class="mt-10 inline-flex items-center justify-center h-12 px-7 rounded-btn bg-accent hover:bg-accent/90 text-white font-semibold transition"
      >
        Join the beta
      </a>
    </div>
  </Section>
</BaseLayout>
