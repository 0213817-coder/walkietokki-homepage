---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
---
<BaseLayout lang="en" title="Reviews" description="From our riders">
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-[32px] md:text-[40px] font-bold tracking-tighter mb-4">From our riders</h1>
      <p class="text-text-secondary leading-body mb-12">
        Stories from cyclists who've actually used WalkieTokki on a ride<br class="hidden sm:block" />
        will be collected and shared around when the beta wraps.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {[1, 2, 3].map(() => (
          <div class="bg-bg-secondary border border-border rounded-card p-6 text-left">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-bg-tertiary"></div>
              <div>
                <div class="h-3 w-20 bg-bg-tertiary rounded mb-1.5"></div>
                <div class="h-2.5 w-14 bg-bg-tertiary/60 rounded"></div>
              </div>
            </div>
            <div class="space-y-2">
              <div class="h-2.5 bg-bg-tertiary/50 rounded"></div>
              <div class="h-2.5 bg-bg-tertiary/50 rounded"></div>
              <div class="h-2.5 w-2/3 bg-bg-tertiary/50 rounded"></div>
            </div>
          </div>
        ))}
      </div>

      <p class="text-text-tertiary text-[13.5px] leading-body mb-8">
        For now, the fastest way to know is to try it yourself.<br />
        You could be the first rider story we publish.
      </p>

      <a
        href="/en/download"
        class="inline-flex items-center justify-center h-12 px-7 rounded-btn bg-accent hover:bg-accent/90 text-white font-semibold transition"
      >
        Download the app
      </a>
    </div>
  </Section>
</BaseLayout>
