---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
---
<BaseLayout lang="en" title="Lost your way" description="404 — Page not found">
  <Section>
    <div class="max-w-md mx-auto text-center">
      <img src="/assets/walkietokki-hero.png" alt="" width="160" height="160" class="mx-auto mb-8" />
      <h1 class="text-[28px] md:text-[34px] font-bold tracking-tighter mb-3">Lost your way</h1>
      <p class="text-text-secondary leading-body mb-8">
        The page you’re looking for doesn’t exist or has moved.
      </p>
      <a
        href="/en/"
        class="inline-flex items-center justify-center h-11 px-6 rounded-btn bg-accent hover:bg-accent/90 text-white text-[14px] font-semibold transition"
      >
        Back to home
      </a>
    </div>
  </Section>
</BaseLayout>
