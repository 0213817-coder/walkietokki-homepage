---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
---
<BaseLayout lang="en" title="Terms of Service" description="WalkieTokki Terms of Service">
  <Section>
    <div class="max-w-2xl mx-auto">
      <h1 class="text-[32px] md:text-[40px] font-bold tracking-tighter mb-4">Terms of Service</h1>
      <p class="text-text-secondary leading-body mb-6">
        The Korean Terms of Service is the legally binding version for now.
        An official English translation is on the way.
      </p>
      <div class="bg-bg-secondary border border-border rounded-card p-7">
        <p class="text-text-secondary text-[14.5px] leading-body">
          For the current Terms, please see the Korean version:{' '}
          <a href="/terms" class="text-accent hover:underline">walkietokki.com/terms</a>.
        </p>
        <p class="text-text-tertiary text-[13px] leading-body mt-4">
          Coming soon: an English translation.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
